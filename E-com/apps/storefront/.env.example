# Server-side Medusa API origin (not exposed to the browser)
MEDUSA_BACKEND_URL=http://localhost:9000

# Public origin (only needed once client components fetch the API directly)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin > Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Razorpay (checkout falls back to manual/system payment when these are empty)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
