# ── Server ─────────────────────────────────────────────
NODE_ENV=production
PORT=9000
MEDUSA_BACKEND_URL=https://YOUR-SERVICE-NAME.onrender.com

# ── Database (Neon / Supabase serverless Postgres) ─────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Redis: sessions, events, cache (Upstash) ───────────
# REDIS_URL=   # optional — free Upstash quota exhausted; unset = in-memory (see DEPLOYMENT §4)

# ── CORS ───────────────────────────────────────────────
STORE_CORS=https://YOUR-STOREFRONT-DOMAIN.com
ADMIN_CORS=https://YOUR-SERVICE-NAME.onrender.com
AUTH_CORS=https://YOUR-SERVICE-NAME.onrender.com

# ── Secrets (generate with: openssl rand -hex 32) ─────
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX
COOKIE_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX

# ── Cloudinary (media CDN) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ── Razorpay (payment provider) ──────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
